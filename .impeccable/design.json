      "html": "<div class=\"ds-row\"><button class=\"ds-select\"><span><strong>main</strong><small>7d83ab1 \u00b7 320 ms</small></span></button><button class=\"ds-pin\" aria-label=\"Use experiment as reference A\">A</button></div>",
      "css": ".ds-row{display:flex;align-items:center;background:#edf3ff;border-radius:4px;font-family:Inter,Arial,sans-serif}.ds-select{font-family:Inter,Arial,sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:4px;padding:6px 9px;min-height:32px;cursor:pointer;flex:1;justify-content:flex-start;text-align:left;background:transparent;padding:9px 7px}.ds-select strong{display:block;font-size:13px;font-weight:500;color:#22262b}.ds-select small{display:block;margin-top:5px;font-size:12px;color:var(--muted,#626872);font-variant-numeric:tabular-nums}.ds-pin{border:1px solid #bdcee9;border-radius:4px;background:#fff;color:var(--accent,#245fca);width:26px;height:28px;padding:0;margin-right:5px;font:12px Inter,Arial,sans-serif}.ds-select:hover,.ds-pin:hover{background:#f1f3f6}.ds-select:focus-visible,.ds-pin:focus-visible{outline:2px solid var(--accent,#245fca);outline-offset:-2px;}@media(max-width:600px){.ds-select,.ds-pin{min-height:44px;min-width:44px}}"
    },
