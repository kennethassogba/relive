  "components": [
    {
      "name": "Run button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action in the command bar.",
      "html": "<button class=\"ds-run\">Run</button>",
      "css": ".ds-run{font-family:Inter,Arial,sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:4px;padding:6px 9px;min-height:32px;cursor:pointer;background:var(--accent,#245fca);color:#fff;border-color:var(--accent,#245fca);padding:7px 12px}.ds-run:hover{background:#194eac}.ds-run:focus-visible{outline:2px solid var(--accent,#245fca);outline-offset:-2px;}.ds-run:disabled{opacity:.45;cursor:default}@media(max-width:600px){.ds-run{min-height:44px;min-width:44px}}"
    },
    {
      "name": "View toggle",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Pressed state selects a visualization option.",
      "html": "<button class=\"ds-toggle\" aria-pressed=\"true\">Wireframe</button>",
      "css": ".ds-toggle{font-family:Inter,Arial,sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:4px;padding:6px 9px;min-height:32px;cursor:pointer;background:transparent;color:#22262b}.ds-toggle:hover{background:#f1f3f6}.ds-toggle[aria-pressed=true]{background:#edf3ff;color:var(--accent,#245fca)}.ds-toggle:focus-visible{outline:2px solid var(--accent,#245fca);outline-offset:-2px;}.ds-toggle:disabled{opacity:.45;cursor:default}@media(max-width:600px){.ds-toggle{min-height:44px;min-width:44px}}"
    },
    {
      "name": "Parameter field",
      "kind": "input",
      "refersTo": "input",
      "description": "A labeled native parameter.",
      "html": "<label class=\"ds-field\">Feature weight <input type=\"number\" min=\"0\" max=\"1000\" value=\"40\"></label>",
      "css": ".ds-field{display:flex;align-items:center;justify-content:space-between;gap:10px;font:13px Inter,Arial,sans-serif;color:#22262b}.ds-field input{font:inherit;background:#fff;color:inherit;border:1px solid #d8dce2;border-radius:4px;padding:6px 8px;min-height:32px;width:76px;font-variant-numeric:tabular-nums}.ds-field input:focus-visible{outline:2px solid var(--accent,#245fca);outline-offset:-2px;}@media(max-width:600px){.ds-field input{min-height:44px}}"
    },
    {
      "name": "Example navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Active example has a blue underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Examples\"><button class=\"ds-active\">PicoRV32</button><button>Jerry</button></nav>",
      "css": ".ds-nav{display:flex;height:43px;gap:8px}.ds-nav button{font-family:Inter,Arial,sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:4px;padding:6px 9px;min-height:32px;cursor:pointer;border-radius:0;border-bottom:2px solid transparent;padding:0 12px;background:transparent;color:var(--muted,#626872)}.ds-nav button.ds-active{color:#22262b;border-bottom-color:var(--accent,#245fca)}.ds-nav button:hover{background:#f1f3f6}.ds-nav button:focus-visible{outline:2px solid var(--accent,#245fca);outline-offset:-2px;}@media(max-width:600px){.ds-nav{height:46px;gap:0}.ds-nav button{min-height:44px;min-width:44px;padding:0 6px;font-size:12px}}"
    },
